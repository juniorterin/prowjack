# Prowlarr ou Jackett (obrigatório)
# Use o nome do serviço Docker se estiver na mesma rede (ex: http://prowlarr:9696)
JACKETT_URL=http://prowlarr:9696
JACKETT_API_KEY=your_prowlarr_api_key_here

# TorrServer — backend de streaming (obrigatório)
# TS_URL é o endereço interno (rede Docker) — só precisa ser alcançável pelo
# addon, nunca pela internet: o player nunca fala com o TorrServer
# diretamente, todo pedido de stream é reencaminhado por este app.
TS_URL=http://torrserver:8090
TS_USER=
TS_PASS=

# Redis (recomendado — cache de buscas; sem isso cai para cache em memória)
REDIS_URL=redis://localhost:6379

# Persistência das configurações cfg_...
# Em VPS/Docker, deixe vazio para usar arquivo em CONFIG_DATA_DIR.
# Em hosting serverless, configure uma URL Postgres.
# Aceita CONFIG_DATABASE_URL, POSTGRES_URL ou DATABASE_URL.
CONFIG_DATABASE_URL=
CONFIG_DATABASE_TABLE=torresmin_configs
CONFIG_DATA_DIR=/data

# URL pública do addon (necessária atrás de proxy/hosting)
# Exemplo: https://addon.seudominio.com
ADDON_PUBLIC_URL=

# Porta interna do servidor
PORT=7860

# Token de acesso (opcional) — impede uso não autorizado do addon
# Deve ser preenchido também no campo "Token de Acesso" na UI de configuração
ACCESS_TOKEN=

# TMDB (opcional) — título/sinopse em pt-BR no catálogo e metadados
# Aceita uma API key v3 ou um Bearer token v4
TMDB_API_KEY=
TMDB_BEARER_TOKEN=

# Catálogo RSS — indexers que alimentam os lançamentos recentes na home do Stremio
# IDs ou nomes separados por vírgula; vazio inclui todos os indexers privados
# Exemplo: RSS_CATALOG_INDEXERS=5,11,CapybaraBR
RSS_CATALOG_INDEXERS=
RSS_UPDATE_INTERVAL_MINUTES=30

# Addons externos (opcional) — manifests do Stremio pra somar resultados aos do Prowlarr/Jackett
# Separados por vírgula
# Exemplo: SCRAP_MANIFEST_URLS=https://torrentio.strem.fun/manifest.json
SCRAP_MANIFEST_URLS=

# CORS (opcional) — origens permitidas, separadas por vírgula. Padrão: todas (*)
ALLOWED_ORIGINS=
